# Nomor WhatsApp admin dalam format internasional tanpa tanda + (contoh format: 62XXXXXXXXXX).
# Biarkan kosong sampai nomor resmi dikonfirmasi. Jika kosong, tombol "Tanya Admin" mengarah ke Instagram.
VITE_WHATSAPP_NUMBER=

# Docker Compose: port host (hanya di-bind ke 127.0.0.1). Default 8102.
HOST_PORT=8102
